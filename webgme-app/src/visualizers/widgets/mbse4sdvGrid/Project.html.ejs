<div id="<%= id %>-node-panel" data-sort="<%= title %>" class="root-viz-item">
  <div class="panel-heading">
    <h3 class="panel-title"><%= title %></h3>
  </div>
  <div class="panel-body">
    <div style="width:'100%';height :'100%';max-width:'80px';max-height :'80px';">
      <object data="<%- image %>" max-width="80" min-height="80"> </object>
    </div>
      
    </div>
    <!--details class="root-viz-details" open><summary class="root-viz-summary"><i id="<%= id %>-authors" class="fa fa-pencil-square" aria-hidden="true"></i><b>  Authors</b></summary><%- authors %></details>
    <details class="root-viz-details" open><summary class="root-viz-summary"><i id="<%= id %>-brief"class="fa fa-pencil-square" aria-hidden="true"></i><b>  Brief Description</b></summary><%- brief %></details-->
    <div class="row">
      <div class="col-xs-5">
        <button id="learn-<%= id %>" type="button" class="btn btn-default">Help</button>
      </div>
    </div>
    <div class="row root-viz-details"><%- description %></div>
  </div>
</div>
