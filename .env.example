# Copy to .env and adjust. Never commit the .env file.

# Administrator account created on first start
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.org
# Leave empty to generate a random password (printed once in "docker compose logs webgme")
ADMIN_PASSWORD=

# Let visitors create their own accounts from the login page
ALLOW_USER_REGISTRATION=false

# Import the example project (linked to the SDV and HFSM libraries) for the administrator on first start
IMPORT_EXAMPLE=true

# Published ports
WEBGME_PORT=8888
MCP_PORT=3000

# Allow the MCP server to read whole model trees (can be heavy on large models)
MCP_ALLOW_FULL_TREE_READS=false
